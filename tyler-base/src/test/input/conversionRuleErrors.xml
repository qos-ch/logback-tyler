<configuration>

    <conversionRule conversionWord="missing" class="com.example.DoesNotExistConverter"/>
    <conversionRule conversionWord="notAConverter" class="java.lang.Object"/>
    <conversionRule conversionWord="abstractConverter" class="ch.qos.logback.classic.pattern.ClassicConverter"/>
