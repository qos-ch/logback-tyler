<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.qos.logback.tyler</groupId>
        <artifactId>tyler-parent</artifactId>
        <version>1.0.7</version>
    </parent>

    <artifactId>tyler-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Tyler Maven Plugin</name>

    <description>
        Translates a logback.xml file into a custom Configurator installed as a service provider
    </description>

    <inceptionYear>2026</inceptionYear>

    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>

    <dependencies>

        <dependency>
            <groupId>ch.qos.logback.tyler</groupId>
            <artifactId>tyler-base</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>tyler</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
